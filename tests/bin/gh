#!/usr/bin/env bash
# Stub of gh for the unit tests of the scripts of .github:
#   release view/edit   notes in $NOTES (edit reads --notes-file -)
#   attestation verify  succeeds when $ATTESTED is set, fails with HTTP 404
#                       otherwise; the attestations are of the commit
#                       $ATTESTED_COMMIT, so --source-digest of another commit
#                       fails
#   api .../commits/tags/T  the commit $TAG_COMMIT of the tag; HTTP 422 when
#                       unset
#   api                 otherwise the gh stub of the shell library in
#                       $SHELL_LIB, which answers from the fixtures of the test
# Changes and checks go to $CALLS.
set -euo pipefail
case "$1 $2" in
  "release view") cat "$NOTES" ;;
  "release edit")
    cat >"$NOTES"
    echo "edit" >>"$CALLS"
    ;;
  "attestation verify")
    echo "verify $*" >>"$CALLS"
    if [[ " $* " == *" --source-digest "* && " $* " != *" --source-digest ${ATTESTED_COMMIT-} "* ]]; then
      echo "stub gh: the attestation is of another commit" >&2
      exit 1
    fi
    if [[ -z ${ATTESTED-} ]]; then
      echo "gh: Not Found (HTTP 404)" >&2
      exit 1
    fi
    ;;
  api\ */commits/tags/*)
    if [[ -z ${TAG_COMMIT-} ]]; then
      echo "gh: No commit found for SHA: ${2#*/commits/} (HTTP 422)" >&2
      exit 1
    fi
    printf '{"sha": "%s"}\n' "$TAG_COMMIT"
    ;;
  api\ *) exec "$SHELL_LIB/internal/testing/bin/gh" "$@" ;;
  *)
    echo "stub gh: unsupported: $*" >&2
    exit 2
    ;;
esac
