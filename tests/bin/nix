#!/usr/bin/env bash
# Stub of nix for the unit tests of scripts/. Records calls in $CALLS.
#   nix path-info --derivation   prints $DERIVATION
#   nix derivation show D...     prints the derivations D of $DERIVATIONS, a
#                                file in the format of `nix derivation show`
#   nix build --print-out-paths  prints $STREAM
#   nix build --rebuild D...     records "rebuild ARGS"; fails with
#                                $REBUILD_ERROR when it is set
#   nix eval ...                 prints $SYSTEM
#   nix run FLAKE#APP -- ...     prints $TARBALL_DIGEST (publish-digest);
#                                fails with $RUN_ERROR when it is set
set -euo pipefail
case $1 in
  eval) printf '%s' "$SYSTEM" ;;
  path-info) echo "$DERIVATION" ;;
  derivation)
    shift 2
    jq --args '.derivations |= with_entries(select(.key | IN($ARGS.positional[])))' \
      "${@#/nix/store/}" <"$DERIVATIONS"
    ;;
  run)
    echo "run $*" >>"$CALLS"
    if [[ -n ${RUN_ERROR-} ]]; then
      echo "$RUN_ERROR" >&2
      exit 1
    fi
    echo "$TARBALL_DIGEST"
    ;;
  build)
    if [[ " $* " == *" --print-out-paths "* ]]; then
      echo "$STREAM"
    elif [[ " $* " == *" --rebuild "* ]]; then
      echo "rebuild ${*:2}" >>"$CALLS"
      if [[ -n ${REBUILD_ERROR-} ]]; then
        echo "$REBUILD_ERROR" >&2
        exit 1
      fi
    else
      echo "build" >>"$CALLS"
    fi
    ;;
  *)
    echo "stub nix: unsupported: $*" >&2
    exit 2
    ;;
esac
