#!/usr/bin/env bash
# Stub of crane for the unit tests of scripts/: a registry in $REGISTRY
# (manifests/<digest>, tags/<tag>); calls that change it go to $CALLS.
# $CRANE_DENIED makes reading a tag fail without MANIFEST_UNKNOWN.
set -euo pipefail
unknown() {
  echo "Error: GET https://ghcr.io/v2/x/manifests/$1: MANIFEST_UNKNOWN: manifest unknown" >&2
  exit 1
}
case $1 in
  digest)
    if [[ $2 == --tarball ]]; then
      echo "$TARBALL_DIGEST"
    elif [[ $2 == *@* ]]; then
      echo "${2#*@}"
    else
      [[ -z ${CRANE_DENIED-} ]] || {
        echo "Error: DENIED: requested access to the resource is denied" >&2
        exit 1
      }
      tag=${2##*:}
      [[ -f $REGISTRY/tags/$tag ]] || unknown "$tag"
      cat "$REGISTRY/tags/$tag"
    fi
    ;;
  manifest)
    if [[ $2 == *@* ]]; then
      digest=${2#*@}
    else
      [[ -f $REGISTRY/tags/${2##*:} ]] || unknown "${2##*:}"
      digest=$(cat "$REGISTRY/tags/${2##*:}")
    fi
    [[ -f $REGISTRY/manifests/$digest ]] || unknown "$digest"
    cat "$REGISTRY/manifests/$digest"
    ;;
  push)
    echo "push ${3#*@}" >>"$CALLS"
    echo '{"mediaType":"application/vnd.docker.distribution.manifest.v2+json"}' >"$REGISTRY/manifests/${3#*@}"
    ;;
  tag)
    echo "tag $3 ${2#*@}" >>"$CALLS"
    echo "${2#*@}" >"$REGISTRY/tags/$3"
    ;;
  ls)
    ls "$REGISTRY/tags"
    ;;
  *)
    echo "stub crane: unsupported: $*" >&2
    exit 2
    ;;
esac
